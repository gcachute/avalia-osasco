# Cabeçalhos de segurança da Cloudflare Pages para todas as páginas.
# CSP: o site só carrega coisas dele mesmo e os ladrilhos de ruas do OpenStreetMap. 'unsafe-inline' é preciso
# porque o Next.js exportado põe os dados da página em scripts embutidos (e o script do tema claro/escuro).
# cloudflareinsights.com: contador de visitas do Cloudflare Web Analytics (sem cookies, não identifica ninguém).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Arquivos com nome que muda a cada versão: podem ficar guardados no navegador por um ano.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Imagem de compartilhamento: o arquivo gerado não tem extensão.
/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png

# Endereços que não devem aparecer no Google (o endereço oficial é deolhoemoz.com.br).
https://www.deolhoemoz.com.br/*
  X-Robots-Tag: noindex
https://deolhoemoz.pages.dev/*
  X-Robots-Tag: noindex
https://:branch.deolhoemoz.pages.dev/*
  X-Robots-Tag: noindex
